<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Read access to HealthKit. Without this claim, signed into the binary, HKHealthStore
	     refuses to grant a store at all — this is Apple's consent, which arrives *before* the
	     user's. The user-facing prompt is separate and is described by NSHealthShareUsageDescription
	     in Info.plist. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
</dict>
</plist>
